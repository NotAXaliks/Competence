<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Desktop.Windows.MainWindow"
        Title="Desktop">
    <StackPanel>
        <Grid ColumnDefinitions="*, *, *, *, *" Margin="0,0,0,10">
            <TextBlock Grid.Column="0">x ИТ-Проф</TextBlock>
            <Image Grid.Column="1" Name="UserAvatar" Width="40" Height="40" />
            <TextBlock Grid.Column="2" Name="UserNameTextBlock" />
            <ComboBox Grid.Column="3" Width="100">
                <ComboBoxItem>Мой профиль</ComboBoxItem>
                <ComboBoxItem>Настройки</ComboBoxItem>
                <ComboBoxItem>Выход</ComboBoxItem>
            </ComboBox>
            <Button Grid.Column="4">Выход</Button>
        </Grid>

        <Grid ColumnDefinitions="200, *">
            <StackPanel Grid.Column="0">
                <Button Click="MainPageSelected">Главная</Button>
                <Button Click="SearchPageSelected">Поиск</Button>
                <Button Click="CompetencePageSelected">Подборки</Button>
                <Button>Отчёты</Button>
                <Button>Аналитика</Button>
                <Button>Администрирование</Button>
            </StackPanel>

            <UserControl Grid.Column="1" Name="UContent" />
        </Grid>
    </StackPanel>
</Window>
