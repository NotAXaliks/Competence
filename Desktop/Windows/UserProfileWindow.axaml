<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Desktop.UserProfileWindow"
        Title="UserProfileWindow">
  <ScrollViewer>
    <StackPanel Spacing="20" Margin="25">
      <StackPanel Orientation="Horizontal" Spacing="15">
        <Image Name="UserAvatar" Width="80" Height="80"/>
        <Ellipse Width="10" Height="10" Fill="Green" />

        <StackPanel VerticalAlignment="Center">
          <TextBlock Name="PublicIdText" FontSize="22" FontWeight="Bold" Foreground="#2196F3"/>
          <TextBlock Name="AnonymNameText" FontSize="16" Foreground="Gray"/>
        </StackPanel>
      </StackPanel>

      <Border Background="#F9F9F9" CornerRadius="10" Padding="20">
        <StackPanel Spacing="15">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="Индекс компетенций"/>
              <TextBlock Name="IndexVal" DockPanel.Dock="Right" FontWeight="Bold"/>
            </DockPanel>
            <ProgressBar Name="IndexBar" Height="15" Foreground="Orange" Minimum="0" Maximum="100"/>
          </StackPanel>

          <StackPanel>
            <DockPanel>
              <TextBlock Text="Доверие сообщества"/>
              <TextBlock Name="TrustVal" DockPanel.Dock="Right" FontWeight="Bold"/>
            </DockPanel>
            <ProgressBar Name="TrustBar" Height="15" Foreground="Green" Minimum="0" Maximum="100"/>
          </StackPanel>

          <TextBlock Name="StatsSummary" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Подтверждённые навыки" FontWeight="Bold" FontSize="18"/>
      <DataGrid Name="SkillsGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Технология" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Уровень" Binding="{Binding LevelDisplay}"/>
          <DataGridTextColumn Header="Подтверждения" Binding="{Binding ConfMarks}" Foreground="Green"/>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="Опыт работы" FontWeight="Bold" FontSize="18"/>
      <ItemsControl Name="ExpItems">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="10">
              <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <UniformGrid Columns="4" Margin="0,20,0,0">
        <Button Content="← Назад" Click="Back_Click"/>
        <Button Content="➕ В подборку" />
        <Button Content="📄 PDF-отчёт" />
        <Button Content="✉ Пригласить" />
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</Window>
