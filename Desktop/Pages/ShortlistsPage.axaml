<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Desktop.ShortlistsPage">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
        <TextBlock FontSize="22" FontWeight="Bold" Text="Подборки кандидатов"/>

        <ComboBox Name="SelectionsCombo" Width="250" PlaceholderText="Выберите подборку" SelectionChanged="SelectionsCombo_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Name="EditButton" Content="Редактировать" />
        <Button Name="CreateNewButton" Content="Новая" />
      </StackPanel>

      <TextBlock Name="SelectionStats" Foreground="Gray"
                 Text="Подборка не выбрана"/>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto, *, Auto" Margin="0,20,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
        <Button Content="Пред." />
        <TextBlock Text="1 / 5" VerticalAlignment="Center" Margin="5,0"/>
        <Button Content="След." />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Button Content="Экспорт подборки" />
        <Button Content="Удалить подборку" />
      </StackPanel>
    </Grid>

    <DataGrid Name="CandidatesGrid" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="Gray" DoubleTapped="UsersGrid_DoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="№" Binding="{Binding Index}" />
        <DataGridTextColumn Header="ID кандидата" Binding="{Binding PublicId}" />
        <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" />

        <DataGridTemplateColumn Header="Действие" >
          <DataTemplate>
            <Button Content="Удалить"
                    Foreground="Red"
                    HorizontalAlignment="Center"/>
          </DataTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
